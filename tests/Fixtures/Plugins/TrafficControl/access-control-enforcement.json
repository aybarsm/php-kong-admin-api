{
  "anonymous": "anonymous-value",
  "match_policy": "if_present",
  "rate_limiting": {
    "redis": {
      "cloud_authentication": {
        "auth_provider": "aws",
        "aws_access_key_id": "aws_access_key_id-value",
        "aws_assume_role_arn": "aws_assume_role_arn-value",
        "aws_cache_name": "aws_cache_name-value",
        "aws_is_serverless": true,
        "aws_region": "aws_region-value",
        "aws_role_session_name": "aws_role_session_name-value",
        "aws_secret_access_key": "aws_secret_access_key-value",
        "azure_client_id": "azure_client_id-value",
        "azure_client_secret": "azure_client_secret-value",
        "azure_tenant_id": "azure_tenant_id-value",
        "gcp_service_account_json": "gcp_service_account_json-value",
        "oauth": {
          "auth_method": "client_secret_basic",
          "client_id": "client_id-value",
          "client_secret": "client_secret-value",
          "client_secret_jwt_alg": "HS256",
          "grant_type": "client_credentials",
          "password": "password-value",
          "redis_username": "redis_username-value",
          "redis_username_claim": "redis_username_claim-value",
          "scopes": [
            "scopes-value"
          ],
          "ssl_verify": true,
          "timeout": 1,
          "token_endpoint": "token_endpoint-value",
          "token_headers": {
            "key": "value"
          },
          "token_post_args": {
            "key": "value"
          },
          "username": "username-value"
        }
      },
      "cluster_max_redirections": 1,
      "cluster_nodes": [
        {
          "ip": "ip-value",
          "port": 1
        }
      ],
      "connect_timeout": 1,
      "connection_is_proxied": true,
      "database": 1,
      "host": "host-value",
      "keepalive_backlog": 1,
      "keepalive_pool_size": 1,
      "password": "password-value",
      "port": 1,
      "read_timeout": 1,
      "send_timeout": 1,
      "sentinel_master": "sentinel_master-value",
      "sentinel_nodes": [
        {
          "host": "host-value",
          "port": 1
        }
      ],
      "sentinel_password": "sentinel_password-value",
      "sentinel_role": "any",
      "sentinel_username": "sentinel_username-value",
      "server_name": "server_name-value",
      "ssl": true,
      "ssl_verify": true,
      "username": "username-value"
    },
    "sync_rate": 1.5
  }
}
