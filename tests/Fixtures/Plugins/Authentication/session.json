{
  "absolute_timeout": 1.5,
  "audience": "audience-value",
  "bind": [
    "ip"
  ],
  "cookie_domain": "cookie_domain-value",
  "cookie_http_only": true,
  "cookie_name": "cookie_name-value",
  "cookie_path": "cookie_path-value",
  "cookie_same_site": "Default",
