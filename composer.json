{
    "name": "aybarsm/kong-admin-api",
    "description": "Framework-agnostic, strictly typed PHP client for the Kong Gateway Admin API (built against Kong Gateway 3.16).",
    "type": "library",
    "license": "MIT",
    "keywords": ["kong", "kong-gateway", "admin-api", "api-client", "psr-18"],
    "homepage": "https://github.com/aybarsm/php-kong-admin-api",
    "authors": [
        {
            "name": "Murat Aybars",
            "email": "hello@aybarsm.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.9.3",
        "guzzlehttp/psr7": "^2.7",
        "psr/http-client": "^1.0.3",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "phpdocumentor/reflection-docblock": "^5.6.3 || ^6.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Aybarsm\\Kong\\AdminApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aybarsm\\Kong\\AdminApi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage --min=90",
        "test:types": "pest --type-coverage --min=100",
        "test:mutate": "pest --mutate --min=80",
        "analyse": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "ci": [
            "@cs",
            "@analyse",
            "@test:types",
            "@test:coverage"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
